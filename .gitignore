# 预置账号明文清单（含 13 位口令）：仅本地存储，不入库、不进 H5 产物、不推远端
accounts.txt

# 增量采集中间产物（每轮自动生成，仅本机/CI 运行用，不入库）
scripts/.changed-lines.txt
# 高德采集进度台账（运行时产物，CI 每轮从资产自动回填，不入库）
scripts/.amap-progress.json
# buspedia 登录态（含 token）与完整编号采集进度：仅本地采集用，不入库
scripts/.buspedia-state.json
scripts/.buspedia-cookie.txt
scripts/.busnumber-runtime.json
# 车辆营运采集的 MD5 反查字典缓存（CI 由 actions/cache 恢复，不入库）
.cache/
# 车辆营运采集产物：数据已直写 Neon 数据库，静态 JSON 仅本机备份不入库
# （1 分钟高频采集若入库会污染 main 历史并触发 Vercel 每天 1440 次重建）
src/static/vehicle-ops/

# 环境变量 / 部署凭据（含 CLOUDFLARE_API_TOKEN 等）：仅本地，不入库
.env
*.env
.env.*
!.env.example
# Wrangler 本地缓存
.wrangler/

